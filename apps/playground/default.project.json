{
  "name": "facet-playground",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "node_modules": {
        "$className": "Folder",
        "@facet-ui": {
          "$path": "node_modules/@facet-ui"
        },
        "@lattice-ui": {
          "$path": "node_modules/@lattice-ui"
        },
        "@rbxts": {
          "$className": "Folder",
          "react": {
            "$path": "node_modules/@rbxts/react"
          },
          "react-roblox": {
            "$path": "node_modules/@rbxts/react-roblox"
          },
          "services": {
            "$path": "node_modules/@rbxts/services"
          }
        },
        "@rbxts-js": {
          "$path": "node_modules/@rbxts-js"
        }
      },
      "TS": {
        "$path": "include"
      },
      "shared": {
        "$path": "out/shared"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Playground": {
          "$path": "out/client"
        }
      }
    }
  }
}
