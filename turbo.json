{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", "biome.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!out/**", "!dist/**", "!include/**", "!.turbo/**"],
      "outputs": ["out/**", "dist/**", "include/**"]
    },
    "typecheck": {
      // `^build`, not `^typecheck`: the CLI reads `@facet-ui/theme`'s emitted
      // .d.ts, so a dependency that has never been built has no types to check
      // against.
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!out/**", "!dist/**", "!include/**", "!.turbo/**"],
      "outputs": []
    },
    "lint": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!out/**", "!dist/**", "!include/**", "!.turbo/**"],
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "outputs": []
    },
    "watch": {
      "cache": false,
      "persistent": true
    }
  }
}
