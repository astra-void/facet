{
  "name": "@facet-ui/playground",
  "version": "0.1.0",
  "private": true,
  "description": "Roblox playground that consumes the working-tree registry",
  "scripts": {
    "build": "pnpm run sync && rbxtsc -p tsconfig.json",
    "watch": "rbxtsc -p tsconfig.json -w",
    "lint": "biome check src",
    "lint:fix": "biome check src --write --unsafe",
    "typecheck": "pnpm run sync && tsc -p tsconfig.json --noEmit",
    "place": "rojo build default.project.json -o playground.rbxlx",
    "sync": "node --import tsx ../../scripts/sync-playground.ts"
  },
  "dependencies": {
    "@facet-ui/react-variants": "workspace:*",
    "@lattice-ui/react-accordion": "^0.8.0",
    "@lattice-ui/react-avatar": "^0.8.0",
    "@lattice-ui/react-checkbox": "^0.8.0",
    "@lattice-ui/react-dialog": "^0.8.0",
    "@lattice-ui/react-focus": "^0.8.0",
    "@lattice-ui/react-layer": "^0.8.0",
    "@lattice-ui/react-motion": "^0.8.0",
    "@lattice-ui/react-progress": "^0.8.0",
    "@lattice-ui/react-radio-group": "^0.8.0",
    "@lattice-ui/react-runtime": "^0.8.0",
    "@lattice-ui/react-scroll-area": "^0.8.0",
    "@lattice-ui/react-slider": "^0.8.0",
    "@lattice-ui/react-switch": "^0.8.0",
    "@lattice-ui/react-tabs": "^0.8.0",
    "@lattice-ui/react-text-field": "^0.8.0",
    "@lattice-ui/react-textarea": "^0.8.0",
    "@lattice-ui/react-toggle-group": "^0.8.0",
    "@rbxts-js/boolean": "^1.2.3-ts.1",
    "@rbxts-js/collections": "^1.2.3-ts.1",
    "@rbxts-js/console": "^1.2.3-ts.1",
    "@rbxts-js/es7-types": "^1.2.3-ts.1",
    "@rbxts-js/instance-of": "^1.2.3-ts.1",
    "@rbxts-js/luau-polyfill": "^1.2.3-ts.1",
    "@rbxts-js/math": "^1.2.3-ts.1",
    "@rbxts-js/number": "^1.2.3-ts.1",
    "@rbxts-js/react": "^17.3.7-ts.1",
    "@rbxts-js/react-globals": "^17.3.7-ts.1",
    "@rbxts-js/react-reconciler": "^17.3.7-ts.1",
    "@rbxts-js/react-roblox": "^17.3.7-ts.1",
    "@rbxts-js/roblox-lua-promise": "^3.5.0-ts.2",
    "@rbxts-js/safe-flags": "^17.3.7-ts.1",
    "@rbxts-js/scheduler": "^17.3.7-ts.1",
    "@rbxts-js/shared": "^17.3.7-ts.1",
    "@rbxts-js/string": "^1.2.3-ts.1",
    "@rbxts-js/symbol-luau": "^1.0.0-ts.1",
    "@rbxts-js/timers": "^1.2.3-ts.1",
    "@rbxts/react": "17.3.7-ts.1",
    "@rbxts/react-roblox": "17.3.7-ts.1",
    "@rbxts/services": "^1.6.0"
  },
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.938",
    "roblox-ts": "^3.0.0",
    "vela-rbxts": "^0.9.0"
  }
}
