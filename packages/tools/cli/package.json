{
  "name": "facet-rbxts",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "Facet CLI — copy Facet components into your roblox-ts project",
  "license": "MIT",
  "homepage": "https://facet.astra-void.xyz",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "facet": "dist/index.js",
    "facet-rbxts": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/astra-void/facet.git",
    "directory": "packages/tools/cli"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check src",
    "lint:fix": "biome check src --write --unsafe",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -p tsconfig.json -w"
  },
  "dependencies": {
    "@facet-ui/theme": "workspace:*"
  },
  "keywords": [
    "roblox",
    "roblox-ts",
    "rbxts",
    "ui",
    "components",
    "facet",
    "shadcn",
    "cli"
  ]
}
