{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "out",
    "baseUrl": ".",
    // roblox-ts maps an import to a Rojo path by taking it relative to this
    // project's own node_modules. Resolving through the symlink to pnpm's store
    // would land outside that directory, so the symlink is what must be kept.
    "preserveSymlinks": true,
    "plugins": [{ "transform": "vela-rbxts/transformer" }],
    "typeRoots": ["./node_modules/@rbxts", "./node_modules/@facet-ui", "./node_modules/@lattice-ui"],
    "types": ["types", "compiler-types"]
  },
  // `src/shared` is generated by `pnpm sync:playground` — the playground consumes
  // components exactly as a project that ran `facet add` would, relative imports
  // and all. `registry/types` supplies Vela's className augmentation.
  "include": ["src", "../../registry/types"],
  "rbxts": {
    "type": "game",
    "rojo": "default.project.json",
    "includePath": "include"
  }
}
